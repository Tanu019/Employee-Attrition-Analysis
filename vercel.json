{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "server.py"
    }
  ],
  "functions": {
    "server.py": {
      "excludeFiles": "{tests/**,.pytest_cache/**,docs/**,styles/**,app.py,src/modules/**,inspect_dataset.py,dataset_profile_raw.json}"
    }
  }
}
